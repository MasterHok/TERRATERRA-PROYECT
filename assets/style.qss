/* ═══════════════════════════════════════════════════════════
   TERRARIA LAUNCHER — Hoja de estilos
   Cambia los colores aquí sin tocar el código Python.
   Colores principales:
     - Rojo Terraria:  #e94560
     - Rojo claro:     #ff5773
     - Rojo oscuro:    #b0304a
     - Fondo:          #1a1a2e
   ═══════════════════════════════════════════════════════════ */

QMainWindow, QWidget { background: transparent; }

QLabel#title_label {
    color: #e94560;
    font-size: 30px;
    font-weight: bold;
    padding: 6px;
    font-family: 'Segoe UI', Arial;
}
QLabel {
    color: #e0e0e0;
    font-size: 12px;
    font-family: 'Segoe UI', Arial;
}
QLabel#field_label {
    font-size: 13px;
    font-weight: bold;
    color: #e94560;
    padding: 2px 0px;
}
QLabel#panel_title {
    color: #e94560;
    font-size: 14px;
    font-weight: bold;
    padding: 0 0 4px 0;
}
QLabel#ram_note {
    color: #a8d8ea;
    font-style: italic;
    font-size: 11px;
    padding: 2px 0px;
}

QFrame#panel {
    background: rgba(0, 0, 0, 0.35);
    border: 2px solid rgba(233, 69, 96, 0.35);
    border-radius: 10px;
}

QLineEdit, QComboBox {
    background: rgba(0, 0, 0, 0.6);
    color: #e94560;
    border: 2px solid #e94560;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    min-height: 26px;
}
QLineEdit:focus, QComboBox:focus {
    border: 2px solid #ff5773;
    background: rgba(0, 0, 0, 0.8);
}
QComboBox::drop-down { border: none; width: 22px; }
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #e94560;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background: rgba(10, 10, 20, 0.98);
    color: #e94560;
    selection-background-color: rgba(233, 69, 96, 0.3);
    selection-color: white;
    padding: 4px;
    border: 2px solid #e94560;
    font-size: 13px;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e94560, stop:1 #b0304a);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 13px;
    min-height: 30px;
}
QPushButton:hover:!disabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ff5773, stop:1 #e94560);
}
QPushButton:disabled { background: #555; color: #888; }

QPushButton#start_button {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e94560, stop:1 #b0304a);
    font-size: 20px;
    min-height: 50px;
    letter-spacing: 3px;
    border-radius: 10px;
}
QPushButton#start_button:hover:!disabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ff5773, stop:1 #e94560);
}

QPushButton#server_main_button {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #7f5af0, stop:1 #5a3fc0);
    font-size: 18px;
    min-height: 48px;
    letter-spacing: 2px;
    border-radius: 10px;
}
QPushButton#server_main_button:hover:!disabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #9b7aff, stop:1 #7f5af0);
}

QPushButton#copy_button {
    min-height: 20px;
    min-width: 40px;
    max-width: 40px;
    padding: 4px;
    font-size: 14px;
}

QPushButton#folder_button {
    min-height: 28px;
    min-width: 34px;
    max-width: 34px;
    padding: 2px;
    font-size: 15px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #b0304a, stop:1 #802030);
}
QPushButton#folder_button:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e94560, stop:1 #b0304a);
}

QTabWidget::pane {
    border: 2px solid rgba(233, 69, 96, 0.4);
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.25);
    top: -1px;
}
QTabBar::tab {
    background: rgba(0, 0, 0, 0.5);
    color: #a8d8ea;
    padding: 10px 18px;
    border: 2px solid rgba(233, 69, 96, 0.4);
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: bold;
    font-size: 13px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: rgba(233, 69, 96, 0.35);
    color: #e94560;
    border-color: #e94560;
}
QTabBar::tab:hover:!selected {
    background: rgba(233, 69, 96, 0.2);
    color: #e94560;
}

QPlainTextEdit {
    background: rgba(0, 0, 0, 0.85);
    color: #7fff7f;
    border: 2px solid #e94560;
    border-radius: 6px;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 11px;
    padding: 6px;
}

QListWidget {
    background: rgba(0, 0, 0, 0.5);
    border: 2px solid rgba(233, 69, 96, 0.5);
    border-radius: 6px;
    color: #e0e0e0;
    font-size: 13px;
    padding: 4px;
}
QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid rgba(233, 69, 96, 0.2);
}
QListWidget::item:selected {
    background: rgba(233, 69, 96, 0.3);
    color: white;
}

QLabel#ip_display {
    color: #e94560;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 13px;
    font-weight: bold;
    padding: 1px 10px;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 6px;
    border: 1px solid rgba(233, 69, 96, 0.5);
    min-width: 380px;
}
QLabel#status_info {
    color: #a8d8ea;
    font-size: 11px;
    padding: 10px;
}